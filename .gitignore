# Secrets — ne jamais committer
.env
.env.*
!.env.example
*.key
*.pem

# Java / Maven
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# Angular / Node
node_modules/
dist/
.angular/
npm-debug.log*
yarn-error.log*

# Interface compilée, déposée dans les ressources de Spring Boot par `ng build`
app/src/main/resources/static/

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# OS
Thumbs.db
desktop.ini
.DS_Store

# Matériel sous licence de l'éditeur — ne jamais publier
# (scans des tuiles, spécialistes, revues, jetons, fiches scénario)
scans/
**/scans/
*.pdf

# Filet de sécurité : aucun visuel de matériel ne doit partir, quel que soit le
# dossier où il atterrit. Deux lots sont déjà tombés hors de la règle ci-dessus.
# Les visuels de l'interface sont l'exception ; ailleurs, `git add -f` si besoin.
*.png
*.jpg
*.jpeg
*.webp
*.tif
*.tiff
!ui/public/**
!ui/src/**

# Notes de travail reprenant le contenu des règles publiées par l'éditeur.
# Restent en local : synthèse des règles, transcription du feuillet officiel.
docs/prive/

# Sauvegardes de parties et fichiers de travail
*.save.json
/tmp/
